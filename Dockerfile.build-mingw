FROM debian:trixie AS toolchain

RUN \
    apt-get update && \
    apt-get -y install --no-install-recommends \
    mingw-w64 build-essential autoconf automake libtool patch make \
    xz-utils curl ca-certificates file && \
    rm -rf /var/lib/apt/lists/*

FROM toolchain AS deps

ARG MSYS2_PACKAGES_REF=d94046575b21a230bd6948830771e5011e7a2571
ENV MSYS2_PACKAGES_REF=${MSYS2_PACKAGES_REF}

COPY tools/mingw/build-deps.sh /opt/build-deps.sh

RUN /opt/build-deps.sh i686-w64-mingw32
RUN /opt/build-deps.sh x86_64-w64-mingw32

FROM deps AS build

RUN mkdir /work
WORKDIR /work

COPY Makefile /work/
COPY src /work/src
COPY tools/mingw/build.sh /work/build.sh

RUN ./build.sh i686-w64-mingw32 /out/x86
RUN ./build.sh x86_64-w64-mingw32 /out/x64

RUN file /out/*/*.exe

FROM scratch AS artifacts

COPY --from=build /out /